# Copiar este archivo a ".env.local" (que ya está en .gitignore, nunca se sube)
# y completar con los valores reales del proyecto en:
# Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key de Supabase (Settings → API → "service_role", NO la
# "anon" key). Solo se usa en rutas de servidor (checkout, webhook) para
# escribir en pedidos/pedido_items sin depender de RLS. Nunca exponer al
# navegador (por eso no lleva prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (Settings → API para la API key, Settings → Stores para el
# Store ID, la página del producto para el Variant ID, Settings → Webhooks
# para el signing secret). Mientras la tienda esté en modo test, usar la
# API key y el webhook de modo test — no hace falta cambiar código para
# pasar a modo live, solo reemplazar estos valores por los de modo live.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Precio informativo (en dólares) que se guarda en pedidos/pedido_items —
# debe coincidir con el precio configurado en la variante de Lemon Squeezy.
# No es lo que cobra Lemon Squeezy (eso lo define la variante en su propio
# dashboard), solo lo que queda registrado en nuestra base de datos.
LEMONSQUEEZY_PRECIO_USD=
